# ─── Gmail credentials ────────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=your_email@gmail.com

# 16-character App Password (NOT your regular Gmail password)
# How to generate: Google Account → Security → 2-Step Verification → App passwords
# App name: "CSGOCASES Monitor"
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Where to send alerts (can be same as GMAIL_USER, or a different address)
NOTIFY_EMAIL=your_email@gmail.com

# ─── Optional: override target sources ────────────────────────────────────────
# Subreddits to monitor (comma-separated)
# REDDIT_SUBREDDITS=CSGOcases,GlobalOffensive,csgo,csgobetting

# Twitter/X accounts to monitor (comma-separated, no @)
# TWITTER_ACCOUNTS=csgocases,CSGOCasescom

# Twitter/X search terms (comma-separated)
# TWITTER_SEARCH_TERMS=csgocases promo code,csgocases bonus code

# Nitter instances to use (comma-separated, no https://)
# NITTER_INSTANCES=nitter.privacydev.net,nitter.poast.org,nitter.cz

# YouTube channel IDs (format: "CHANNEL_ID:Display Name", comma-separated)
# YOUTUBE_CHANNELS=UCvNgMEarKwLTTf0f8Te2z3Q:CSGOCASES Official

# Telegram public channels to monitor (comma-separated, no @)
# TELEGRAM_CHANNELS=csgocases,csgo_promo_codes

# ─── Advanced tuning ──────────────────────────────────────────────────────────
# HTTP request timeout in seconds (default: 20)
# REQUEST_TIMEOUT=20

# Path to the state file (default: state.json)
# STATE_FILE=state.json
